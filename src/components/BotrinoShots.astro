---
// Schermate di Botrino su Discord per la pagina progetto. Le immagini stanno in
// src/assets/botrino/, le descrizioni in src/data/botrinoShots.ts.
import type { ImageMetadata } from 'astro'
import type { Lang } from '../i18n/ui'
import { Image } from 'astro:assets'
import { botrinoShots } from '../data/botrinoShots'

interface Props { lang: Lang }
const { lang } = Astro.props

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/botrino/*.{png,jpg,jpeg,webp}',
  { eager: true },
)

const shots = Object.entries(files)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const name = path.split('/').pop()!
    const alt = botrinoShots[name]
    if (!alt) throw new Error(`Manca la descrizione di src/assets/botrino/${name} in src/data/botrinoShots.ts`)
    return { src: mod.default, alt: alt[lang] }
  })
---

{shots.length > 0 && (
  <ul class="botrino-shots">
    {shots.map((shot) => (
      <li><Image src={shot.src} alt={shot.alt} width={860} widths={[430, 860]} sizes="(max-width: 600px) 100vw, 430px" loading="lazy" /></li>
    ))}
  </ul>
)}

<style>
  .botrino-shots {
    list-style: none;
    margin: 0 0 3rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    align-items: start;
  }
  .botrino-shots img { display: block; width: 100%; height: auto; border-radius: 10px; }
  @media (max-width: 600px) {
    .botrino-shots { grid-template-columns: 1fr; }
  }
</style>
