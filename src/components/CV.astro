---
import type { Lang } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'
import { getProjectBySlug } from '../data/projects'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)

const isIT = lang === 'it'
const homeHref = isIT ? '/' : '/en/'
const pdfHref = isIT ? '/CV_Marco_Luigi_Botrugno.pdf' : '/CV_Marco_Luigi_Botrugno_EN.pdf'

const experience = isIT ? [
  {
    period: `mar 2022 – ${t('cv.present')}`,
    role: 'Full-Stack Developer',
    company: 'BarbarHouse S.R.L.',
    location: 'Casarano (LE)',
    note: 'Sviluppo front-end e back-end.',
  },
  {
    period: 'estati 2019 – 2021',
    role: 'Maître, responsabile di sala',
    company: 'La Casarana Wellness Eco Resort',
    location: 'Presicce-Acquarica (LE)',
    note: 'Tre stagioni estive, prima come cameriere, poi vice-maître e infine responsabile della sala.',
  },
  {
    period: '2018 – 2019',
    role: 'Tecnico informatico in alternanza scuola-lavoro',
    company: 'Diemme Service, Casarano; Ciemme Informatica, Presicce',
  },
] : [
  {
    period: `Mar 2022 – ${t('cv.present')}`,
    role: 'Full-Stack Developer',
    company: 'BarbarHouse S.R.L.',
    location: 'Casarano (LE)',
    note: 'Front-end and back-end development.',
  },
  {
    period: 'summers 2019 – 2021',
    role: "Maître d', dining room manager",
    company: 'La Casarana Wellness Eco Resort',
    location: 'Presicce-Acquarica (LE)',
    note: "Three summer seasons: first as a waiter, then assistant maître d', and finally in charge of the dining room.",
  },
  {
    period: '2018 – 2019',
    role: 'IT technician, school work-experience program',
    company: 'Diemme Service, Casarano; Ciemme Informatica, Presicce',
  },
]

const education = isIT ? [
  {
    period: `set 2020 – ${t('cv.present')}`,
    degree: 'Informatica e Tecnologie per la produzione del Software',
    institution: 'Università degli Studi di Bari Aldo Moro',
    location: 'Bari',
  },
  {
    period: 'set 2015 – giu 2020',
    degree: 'Diploma di Perito industriale in Informatica',
    institution: 'IIS "A. Meucci"',
    location: 'Casarano (LE)',
    note: 'Voto finale: 90/100',
  },
] : [
  {
    period: `Sep 2020 – ${t('cv.present')}`,
    degree: 'Computer Science and Software Production Technologies',
    institution: 'Università degli Studi di Bari Aldo Moro',
    location: 'Bari',
  },
  {
    period: 'Sep 2015 – Jun 2020',
    degree: 'Diploma in Industrial Computing',
    institution: 'IIS "A. Meucci"',
    location: 'Casarano (LE)',
    note: 'Final grade: 90/100',
  },
]

const certifications = [
  {
    year: '2019',
    title: 'Introduction to Cybersecurity',
    issuer: 'Cisco Networking Academy',
  },
  {
    year: '2018',
    title: 'Preliminary English Test (PET) – B1',
    issuer: 'Cambridge Assessment English',
  },
  {
    year: '2013',
    title: isIT ? "Giochi Matematici d'Autunno – 3° posto Cat. C1" : 'Autumn Mathematics Games – 3rd place Cat. C1',
    issuer: 'PRISTEM, Università Bocconi',
  },
]

const skills = [
  { category: 'Frontend', items: ['Vue 3', 'React', 'Nuxt.js', 'Astro', 'TypeScript', 'JavaScript', 'HTML & CSS', 'Bootstrap'] },
  { category: 'Backend',  items: ['Node.js', 'Fastify', 'PHP', 'Yii', 'MySQL', 'Redis', 'Prisma', 'Socket.io'] },
  { category: 'Mobile',   items: ['Ionic', 'Capacitor', 'Firebase', 'Android'] },
  { category: isIT ? 'Linguaggi e strumenti' : 'Languages and tools', items: ['C / C++', 'Java', 'Python', 'Git', 'Docker', 'Vite', 'LaTeX'] },
]

const languages = isIT ? [
  { lang: 'Italiano', level: 'Madrelingua' },
  { lang: 'Inglese',  level: 'B1 — PET' },
] : [
  { lang: 'Italian', level: 'Native' },
  { lang: 'English', level: 'B1 — PET' },
]

const hobbies = isIT
  ? ['Calcetto', 'Pallavolo', 'Fantacalcio', 'Cybersecurity', 'Internet of Things', 'Grafica e design', 'Psicoanalisi']
  : ['Five-a-side football', 'Volleyball', 'Fantasy football', 'Cybersecurity', 'Internet of Things', 'Graphic design', 'Psychoanalysis']

// Stessi testi del CV in PDF (cv/cv-it.html, cv/cv-en.html)
const projectBase = isIT ? '/projects' : '/en/projects'
const matchready = getProjectBySlug('matchready')
const featured = {
  slug: 'matchready',
  title: 'MatchReady',
  description: isIT
    ? "App per organizzare partite amatoriali tra amici. L'ho progettata, sviluppata e pubblicata da solo; è disponibile su App Store e Play Store."
    : 'An app for organising amateur matches among friends. I designed, built and published it on my own; it is available on the App Store and Play Store.',
  features: isIT
    ? ['Eventi con data, luogo, costi e posti', 'Formazioni Team A contro Team B', 'Chat in tempo reale con Socket.io', 'Notifiche push su iOS e Android', 'Pagelle, MVP e classifiche di stagione', 'Scelta del campo su mappa']
    : ['Events with date, venue, costs and spots', 'Team A vs Team B line-ups', 'Real-time chat with Socket.io', 'Push notifications on iOS and Android', 'Player ratings, MVP and season standings', 'Pitch selection on a map'],
  stack: 'Vue 3, Ionic, Capacitor, Node.js, MySQL, Redis, Socket.io, Firebase',
}
const otherProjects = [
  {
    slug: 'shipflow',
    title: 'ShipFlow',
    kind: 'SaaS B2B',
    description: isIT
      ? 'Gestionale multi-tenant per spedizioni aziendali, con dati separati per ogni cliente.'
      : 'Multi-tenant management system for business shipments, with separate data for each client.',
    stack: 'React, TypeScript, Fastify, Prisma, MySQL',
  },
  {
    slug: 'levenshtein-mysql-udf',
    title: 'Levenshtein MySQL UDF',
    kind: 'open source',
    description: isIT
      ? 'Funzione in C per MySQL e MariaDB: ricerca fuzzy e deduplica nel database.'
      : 'A C function for MySQL and MariaDB: fuzzy search and deduplication inside the database.',
    stack: 'C, MySQL, MariaDB, Docker',
  },
  {
    slug: 'algorhythm',
    title: 'AlgoRhythm',
    kind: isIT ? 'Spotify e Gemini' : 'Spotify and Gemini',
    description: isIT
      ? 'Classifica la libreria Spotify per genere e mood e crea le playlist.'
      : 'Sorts a Spotify library by genre and mood and builds the playlists.',
    stack: 'Python, Streamlit, Spotify API',
  },
  {
    slug: 'botrino',
    title: 'Botrino',
    kind: isIT ? 'bot Discord' : 'Discord bot',
    description: isIT
      ? 'Livelli XP, ruoli automatici e report delle sessioni vocali.'
      : 'XP levels, automatic roles and voice session reports.',
    stack: 'Python, discord.py, MySQL',
  },
]
---

<section style="max-width: 780px; margin: 0 auto; padding: 7rem 1.5rem 5rem;">

  <a href={homeHref} class="cv-back">{t('cv.back')}</a>

  <div class="cv-header fade-up">
    <div>
      <p class="section-label" style="margin-bottom: 0.5rem;">{t('nav.cv')}</p>
      <h1 style="font-family: 'Syne', sans-serif; font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -0.02em; line-height: 1.1;">
        Marco Luigi <span class="gradient-text">Botrugno</span>
      </h1>
    </div>
    <a href={pdfHref} download class="btn-red cv-download">{t('cv.download')}</a>
  </div>

  <div class="cv-profile fade-up">
    <p class="cv-profile-role">{t('cv.role')}</p>
    <p class="cv-profile-text">{t('cv.summary')}</p>
  </div>

  <!-- Esperienza -->
  <div class="cv-section fade-up">
    <h2 class="cv-section-title">{t('cv.experience')}</h2>
    <div class="cv-timeline">
      {experience.map(item => (
        <div class="cv-item">
          <span class="cv-period">{item.period}</span>
          <div class="cv-dot"></div>
          <div class="cv-content">
            <p class="cv-role">{item.role}</p>
            <p class="cv-company">{item.company}{item.location && ` · ${item.location}`}</p>
            {item.note && <p class="cv-note">{item.note}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Progetti -->
  <div class="cv-section fade-up">
    <h2 class="cv-section-title">{t('cv.projects')}</h2>
    <div class="cv-project-featured">
      <p class="cv-role"><a href={`${projectBase}/${featured.slug}/`} class="cv-project-link">{featured.title} ↗</a></p>
      <p class="cv-company">{featured.description}</p>
      <ul class="cv-features">
        {featured.features.map(f => <li>{f}</li>)}
      </ul>
      <p class="cv-stack">{featured.stack}</p>
      <p class="cv-stores">
        <a href={matchready?.links.appStore} target="_blank" rel="noopener noreferrer">App Store ↗</a>
        <a href={matchready?.links.playStore} target="_blank" rel="noopener noreferrer">Play Store ↗</a>
      </p>
    </div>
    <div class="cv-projects-grid">
      {otherProjects.map(p => (
        <div>
          <p class="cv-role">
            <a href={`${projectBase}/${p.slug}/`} class="cv-project-link">{p.title} ↗</a>
            <span class="cv-project-kind">{p.kind}</span>
          </p>
          <p class="cv-company">{p.description}</p>
          <p class="cv-stack">{p.stack}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Formazione -->
  <div class="cv-section fade-up">
    <h2 class="cv-section-title">{t('cv.education')}</h2>
    <div class="cv-timeline">
      {education.map(item => (
        <div class="cv-item">
          <span class="cv-period">{item.period}</span>
          <div class="cv-dot"></div>
          <div class="cv-content">
            <p class="cv-role">{item.degree}</p>
            <p class="cv-company">{item.institution} · {item.location}</p>
            {item.note && <p class="cv-note">{item.note}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Certificazioni -->
  <div class="cv-section fade-up">
    <h2 class="cv-section-title">{t('cv.certifications')}</h2>
    <div class="cv-timeline">
      {certifications.map(item => (
        <div class="cv-item">
          <span class="cv-period">{item.year}</span>
          <div class="cv-dot"></div>
          <div class="cv-content">
            <p class="cv-role">{item.title}</p>
            <p class="cv-company">{item.issuer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Competenze -->
  <div class="cv-section fade-up">
    <h2 class="cv-section-title">{t('cv.skills')}</h2>
    <div class="cv-skills-grid">
      {skills.map(group => (
        <div>
          <p class="cv-skills-category">{group.category}</p>
          <div class="cv-tags">
            {group.items.map(item => (
              <span class="badge badge-gray">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Lingue -->
  <div class="cv-section fade-up">
    <h2 class="cv-section-title">{t('cv.languages')}</h2>
    <div class="cv-langs">
      {languages.map(l => (
        <div class="cv-lang-item">
          <span class="cv-role" style="font-size: 0.95rem;">{l.lang}</span>
          <span class="cv-note" style="margin-top: 0;">{l.level}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Hobby -->
  <div class="cv-section fade-up">
    <h2 class="cv-section-title">{t('cv.hobbies')}</h2>
    <div class="cv-tags">
      {hobbies.map(h => (
        <span class="badge badge-gray">{h}</span>
      ))}
    </div>
  </div>

</section>

<style>
  .cv-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 2.5rem;
    transition: color 0.2s;
  }
  .cv-back:hover { color: var(--text); }

  .cv-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
    flex-wrap: wrap;
  }

  .cv-download {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .cv-section {
    margin-bottom: 3rem;
  }

  .cv-section-title {
    font-family: 'Syne', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .cv-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .cv-item {
    display: grid;
    grid-template-columns: 160px 1px 1fr;
    gap: 0 1.5rem;
    align-items: start;
    padding-bottom: 1.5rem;
    position: relative;
  }

  .cv-item:not(:last-child) .cv-dot::after {
    content: '';
    position: absolute;
    left: calc(160px + 1.5rem - 0.5px);
    top: 8px;
    bottom: 0;
    width: 1px;
    background: rgba(255,255,255,0.08);
  }

  .cv-period {
    font-size: 0.8rem;
    color: var(--muted);
    padding-top: 2px;
    line-height: 1.4;
  }

  .cv-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--red);
    margin-top: 4px;
    flex-shrink: 0;
    position: relative;
    justify-self: center;
  }

  .cv-content {
    padding-bottom: 0;
  }

  .cv-role {
    font-family: 'Syne', sans-serif;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .cv-company {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .cv-note {
    font-size: 0.8rem;
    color: var(--blue);
    margin-top: 0.2rem;
  }

  .cv-skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .cv-skills-category {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }

  .cv-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cv-langs {
    display: flex;
    gap: 3rem;
  }

  .cv-lang-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .cv-profile {
    margin: -1.5rem 0 3rem;
  }

  .cv-profile-role {
    font-size: 1rem;
    font-weight: 600;
    color: var(--red);
    margin-bottom: 0.75rem;
  }

  .cv-profile-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 640px;
  }

  .cv-project-featured {
    margin-bottom: 2rem;
  }

  .cv-project-link {
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s;
  }
  .cv-project-link:hover { color: var(--red); }

  .cv-project-kind {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--muted);
    margin-left: 0.5rem;
  }

  .cv-features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.3rem 1.5rem;
    margin: 0.75rem 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    color: var(--text);
  }
  .cv-features li::before {
    content: '– ';
    color: var(--red);
  }

  .cv-stack {
    font-size: 0.8rem;
    color: var(--muted);
    margin-top: 0.35rem;
  }

  .cv-stores {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.6rem;
    font-size: 0.85rem;
  }
  .cv-stores a {
    color: var(--blue);
    text-decoration: none;
  }
  .cv-stores a:hover { text-decoration: underline; }

  .cv-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem 1.5rem;
  }

  @media (max-width: 600px) {
    .cv-skills-grid { grid-template-columns: 1fr; }
    .cv-langs { gap: 1.5rem; }
    .cv-features, .cv-projects-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 600px) {
    .cv-item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
      padding-bottom: 1.75rem;
      padding-left: 1rem;
      border-left: 1px solid rgba(255,255,255,0.08);
    }
    .cv-item:not(:last-child) .cv-dot::after { display: none; }
    .cv-dot { display: none; }
    .cv-period { font-size: 0.75rem; color: var(--red); }
    .cv-header { flex-direction: column; align-items: flex-start; }
  }
</style>
