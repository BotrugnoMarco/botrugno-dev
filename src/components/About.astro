---
import type { Lang } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'
import { age } from '../data/career.js'
import { Image } from 'astro:assets'
import photo from '../assets/marco.jpg'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)
const years = age()

const domains = [
  { title: 'Frontend',  skills: ['Vue 3', 'Nuxt.js', 'React', 'Astro', 'TypeScript', 'JavaScript', 'HTML & CSS', 'Bootstrap'] },
  { title: 'Backend',   skills: ['Node.js', 'Fastify', 'PHP', 'MySQL', 'Redis', 'Prisma', 'Socket.io', 'Yii'] },
  { title: 'Mobile',    skills: ['Ionic', 'Capacitor', 'Firebase', 'Android'] },
  { title: lang === 'it' ? 'Strumenti' : 'Tools', skills: ['Git', 'Docker', 'Vite', 'LaTeX'] },
  { title: lang === 'it' ? 'Linguaggi' : 'Languages', skills: ['C / C++', 'Java', 'Python'] },
]

---

<div class="section-divider"></div>

<section id="about" class="about-section">
  <div class="section-container">

    <div class="section-header fade-up">
      <h2 class="section-title">{t('about.title')}</h2>
    </div>

    <div class="about-grid">

      <div class="about-photo fade-up delay-1">
        <Image src={photo} alt="Marco Luigi Botrugno" widths={[320, 640]} sizes="(max-width: 900px) 240px, 320px" loading="lazy" />
      </div>

      <div class="about-text fade-up delay-1">
        <p class="about-bio">{t('about.bio1').replace('{age}', String(years))}</p>
        <p class="about-bio">{t('about.bio2')}</p>
        <p class="about-bio">{t('about.bio3')}</p>
        <p class="about-bio">{t('about.bio4')}</p>

      </div>

      <div class="about-skills-col fade-up delay-2">
        <div class="about-domains">
          {domains.map(domain => (
            <div class="about-domain">
              <p class="about-domain-title">{domain.title}</p>
              <p class="about-skills">{domain.skills.join(' · ')}</p>
            </div>
          ))}
        </div>

      </div>

    </div>
  </div>
</section>
