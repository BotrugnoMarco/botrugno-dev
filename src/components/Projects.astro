---
import { projects, getProjectContent } from '../data/projects'
import type { Lang } from '../i18n/ui'
import { useTranslations } from '../i18n/utils'
import { Image } from 'astro:assets'
import lddIt from '../assets/ledimoredidaniela/it/desktop.jpg'
import lddEn from '../assets/ledimoredidaniela/en/desktop.jpg'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = useTranslations(lang)

const projectBase = lang === 'en' ? '/en/projects' : '/projects'
// Match Ready ha la sua sezione nella home; botrugno.dev è il sito stesso, linkato dal footer.
// Le Dimore di Daniela (lavoro per un cliente, online) va in una scheda larga sopra la griglia.
const featured = projects.find(p => p.slug === 'ledimoredidaniela')!
const featuredContent = getProjectContent(featured, lang)
const others = projects.filter(p => !['matchready', 'botrugno-dev', 'ledimoredidaniela'].includes(p.slug))
---

<div class="section-divider"></div>

<section id="projects" style="padding: 6rem 0;">
  <div class="section-container">

    <div class="fade-up" style="margin-bottom: 3.5rem;">
      <h2 class="section-title">{t('projects.title')}</h2>
    </div>

    <a href={`${projectBase}/${featured.slug}/`} class="project-card featured-card fade-up">
      <Image
        src={lang === 'en' ? lddEn : lddIt}
        alt={t('ldd.shot.desktop')}
        width={1040}
        widths={[520, 1040]}
        sizes="(max-width: 900px) 100vw, 520px"
        class="featured-shot"
      />
      <div class="featured-body">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
          <h3 style="font-family: 'Syne', sans-serif; font-size: 1.3rem; font-weight: 700; color: var(--text); line-height: 1.3;">{featuredContent.title}</h3>
          <span style="color: var(--muted); flex-shrink: 0; font-size: 1rem; transition: color 0.2s; margin-top: 4px;">→</span>
        </div>
        <p style="font-size: 0.9rem; color: var(--muted); line-height: 1.65;">{featuredContent.description}</p>
        <p class="tech-line" style="margin-top: auto;">{featured.tags.join(' · ')}</p>
      </div>
    </a>

    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem;" class="projects-grid">
      {others.map((project, i) => {
        const content = getProjectContent(project, lang)
        return (
          <a
            href={`${projectBase}/${project.slug}/`}
            class={`project-card fade-up delay-${Math.min(i + 1, 4)}`}
          >
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
              <h3 style="font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 700; color: var(--text); line-height: 1.3;">{content.title}</h3>
              <span style="color: var(--muted); flex-shrink: 0; font-size: 1rem; transition: color 0.2s; margin-top: 2px;">→</span>
            </div>
            <p style="font-size: 0.875rem; color: var(--muted); line-height: 1.65; flex: 1;">{content.description}</p>
            <p class="tech-line" style="margin-top: auto;">{project.tags.join(' · ')}</p>
          </a>
        )
      })}
    </div>

    <div class="fade-up" style="text-align: center; margin-top: 3rem;">
      <a
        href="https://github.com/BotrugnoMarco"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-outline"
      >
        {t('projects.github')}
      </a>
    </div>

  </div>
</section>

<style>
  .featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem;
    align-items: stretch;
    margin-bottom: 1.25rem;
  }
  .featured-shot { display: block; width: 100%; height: auto; border-radius: 0.5rem; }
  .featured-body { display: flex; flex-direction: column; gap: 0.75rem; padding: 0.25rem 0; }
  @media (max-width: 900px) { .featured-card { grid-template-columns: 1fr; gap: 1.25rem; } }
  @media (max-width: 900px) { .projects-grid { grid-template-columns: 1fr 1fr !important; } }
  @media (max-width: 600px) { .projects-grid { grid-template-columns: 1fr !important; } }
</style>
