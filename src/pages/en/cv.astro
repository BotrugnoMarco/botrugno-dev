---
import Layout from '../../layouts/Layout.astro'
import CV from '../../components/CV.astro'
import { cvSchema } from '../../data/schema'

const title = 'Resume — Marco Luigi Botrugno'
const schema = await cvSchema('en', title)
---

<Layout
  lang="en"
  title={title}
  schema={schema}
  description="Resume of Marco Luigi Botrugno, Full-Stack Developer with experience in Vue, React, Node.js, Fastify and mobile development with Ionic."
>
  <CV lang="en" />
</Layout>
