---
import Layout from '../../layouts/Layout.astro'
import Hero from '../../components/Hero.astro'
import About from '../../components/About.astro'
import MatchReady from '../../components/MatchReady.astro'
import Projects from '../../components/Projects.astro'
import Contact from '../../components/Contact.astro'
import { personSchema } from '../../data/person'
import { getImage } from 'astro:assets'
import marcoPhoto from '../../assets/marco.jpg'

// foto per i dati strutturati: URL assoluto di una versione JPG da 600 px
const photo = await getImage({ src: marcoPhoto, width: 600, format: 'jpg' })
const schema = { ...personSchema('en'), image: new URL(photo.src, 'https://botrugno.dev').href }
---

<Layout lang="en" schema={schema}>
  <Hero lang="en" />
  <About lang="en" />
  <MatchReady lang="en" />
  <Projects lang="en" />
  <Contact lang="en" />
</Layout>
